# uClibc-ng math tests
# Licensed under the LGPL v2.1, see the file COPYING.LIB in this tarball.

# build every test additionally at -O2 (see Test.mak)
O2_TWINS := 1

# libm-test.c is a generated file used by the tests internally so skip it
TESTS_DISABLED := libm-test

# gamma (removed from TESTS, need to add "small errors are ok" machinery there)
TESTS_DISABLED += gamma

# test-ldouble, test-ildoubl, compile_test and basic-test used to be gated on
# UCLIBC_HAS_LONG_DOUBLE_MATH here.  That variable is always empty -- the test
# suite never reads uClibc-ng's .config -- so the gate fired on every target
# while all CI configs set the option to y, and four tests never ran anywhere.
# Each of the three now asks math.h for __NO_LONG_DOUBLE_MATH and skips itself
# when the *l entry points are absent; basic-test derives NO_LONG_DOUBLE the
# same way.  c99_test was collateral: it does not mention long double at all.
#
# The two below stay off, but for a reason that can be named rather than an
# always-empty variable: they cannot pass anywhere LDBL_MANT_DIG > 53.  Every
# *l entry point is a double wrapper (libm/ldouble_wrappers.c), so the argument
# loses its low mantissa bits before the work starts.  Measured on i686, where
# long double carries 64 bits: 111 errors, all of that one cause -- 76 results
# with a mantissa cut to 53 bits, 24 integer results sitting exactly on 2^52,
# 2^53, 2^56 or 2^63, and 11 per-function ulp budgets overrun.  fabsl(-e) is
# wrong too, which shows it is not a question of accuracy: fabs is exact in any
# precision and can only miss because the value went through double.  Turn
# these on when long double is implemented per format, not wrapped.
TESTS_DISABLED += test-ldouble test-ildoubl

DODIFF_rint     := 1
DODIFF_signgam  := 1

# NOTE: For basic-test we must disable the floating point optimization.
#       Only for sh architecture because in the other architecture are disabled.
ifeq ($(TARGET_ARCH),sh)
CFLAGS_basic-test += -mieee
endif
EXTRA_CFLAGS    := -fno-builtin

# alpha traps on NaN, infinity and denormals unless the code is compiled with
# -mieee, so every test that reaches one of those dies of SIGFPE.  uClibc-ng
# builds itself that way already (CPU_CFLAGS-y in Rules.mak); the tests have to
# match, or 22 of them here exit 136.
ifeq ($(TARGET_ARCH),alpha)
EXTRA_CFLAGS    += -mieee
endif
EXTRA_LDFLAGS   := -lm

PERL := perl

MDEPS := $(wildcard test-*.c)
$(MDEPS): libm-test.c

# One table for all targets -- see the comment in libm-test-ulps for why.
libm-test.c: libm-test-ulps libm-test.inc gen-libm-test.pl
	$(Q)$(PERL) ./gen-libm-test.pl -u libm-test-ulps ./libm-test.inc -o "." 2>&1 > /dev/null

EXTRA_CLEAN := libm-test.c libm-test-ulps.h
