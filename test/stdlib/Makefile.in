TESTS_DISABLED :=
# ptytest.c asks features.h itself.  testarc4random is switched off by
# get_disabled_tests.py unless UCLIBC_HAS_ARC4RANDOM is set: arc4random()
# exists in neither the headers nor the library otherwise, so the test could
# not even be built.
