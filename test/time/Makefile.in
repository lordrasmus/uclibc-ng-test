# uClibc-ng time tests
# Licensed under the LGPL v2.1, see the file COPYING.LIB in this tarball.

# tst-ftime_l and tst_wcsftime ask features.h themselves.  The suite never
# reads uClibc's .config, so these variables were always empty and both tests
# were disabled on every target.

CFLAGS_tst-strptime2 := -std=c99
# ISO C11 only: <time.h> must give it struct timespec and timespec_get.
# Asked for with the feature macro, not -std=c11, which gcc before 4.6
# does not know (avr32).
CFLAGS_tst-timespec_get := -U_GNU_SOURCE -D_ISOC11_SOURCE
# ISO C23 only
CFLAGS_tst-timespec_getres := -U_GNU_SOURCE -D_ISOC23_SOURCE

DODIFF_futimens1 := 1
DODIFF_tst_wcsftime := 1
